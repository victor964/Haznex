# Copy to .env and fill in real values. Never commit .env to Git.

SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=vhbridge
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Product price calculator: GBP inputs → KES final price
GBP_TO_KES_RATE=165.00

# Frontend dev server (React/Vite default port)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# M-Pesa Daraja API — register at https://developer.safaricom.co.ke
# Use sandbox until you have live credentials and a public callback URL.
MPESA_ENVIRONMENT=sandbox
# App Consumer Key from Daraja portal (My Apps → your app → Consumer Key)
MPESA_CONSUMER_KEY=
# App Consumer Secret from Daraja portal
MPESA_CONSUMER_SECRET=
# Sandbox test paybill shortcode (do not change for local sandbox testing)
MPESA_SHORTCODE=174379
# Sandbox Lipa Na M-Pesa Online passkey (Safaricom public test value)
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Full URL Safaricom POSTs STK results to — must be HTTPS and reachable when STK is on
# Example: https://your-subdomain.ngrok.io/payments/callback/
MPESA_CALLBACK_URL=https://placeholder.ngrok.io/payments/callback/
# Set True only when callback URL is live and consumer key/secret are valid
MPESA_STK_ENABLED=False

# Gmail SMTP — Django sends order status emails (no third-party package)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Gmail address emails are sent from (Victor fills this)
EMAIL_HOST_USER=
# Gmail App Password — NOT your Gmail account password
# Generate at myaccount.google.com → Security → App Passwords
EMAIL_HOST_PASSWORD=
# With Gmail SMTP, use your Gmail address here (must match EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=Haznex <your@gmail.com>
# Set True only when EMAIL_HOST_USER and EMAIL_HOST_PASSWORD are configured
EMAIL_NOTIFICATIONS_ENABLED=False
# Public site URL for links in emails (no trailing slash)
SITE_URL=http://127.0.0.1:8000
